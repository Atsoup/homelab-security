<!-- Wazuh rules for Authentik identity events (IDs 100700-100719).
     Authentik writes structured JSON; with Docker's json-file log driver each line sits in the "log" field,
     so these rules match on that field after Wazuh's built-in JSON decoder.
     Validated against 21,000+ real Authentik log lines and synthetic test events (see test-results.md).
     Note: Authentik's model_name values are lowercase (e.g. webauthndevice, expressionpolicy). -->
<group name="authentik,identity,">
  <rule id="100700" level="0">
    <decoded_as>json</decoded_as>
    <field name="log" type="pcre2">"(logger|domain_url|event)":</field>
    <field name="log" type="pcre2">authentik</field>
    <description>Authentik log line</description>
  </rule>
  <rule id="100701" level="5">
    <if_sid>100700</if_sid>
    <field name="log" type="pcre2">"action":\s*"login_failed"</field>
    <description>Authentik: failed sign-in</description>
    <group>authentication_failed,</group>
  </rule>
  <rule id="100702" level="10" frequency="8" timeframe="300">
    <if_matched_sid>100701</if_matched_sid>
    <description>Authentik: 8+ failed sign-ins in 5 minutes (possible password spraying or brute force)</description>
    <group>authentication_failures,</group>
    <mitre><id>T1110</id></mitre>
  </rule>
  <rule id="100703" level="3">
    <if_sid>100700</if_sid>
    <field name="log" type="pcre2">"action":\s*"login"</field>
    <description>Authentik: successful sign-in</description>
    <group>authentication_success,</group>
  </rule>
  <rule id="100704" level="8">
    <if_sid>100700</if_sid>
    <field name="log" type="pcre2">"action":\s*"model_created".*"model_name":\s*"(webauthndevice|totpdevice|staticdevice|duodevice|smsdevice|endpointdevice)"</field>
    <description>Authentik: new passkey or MFA device enrolled</description>
    <group>account_changed,</group>
  </rule>
  <rule id="100705" level="10">
    <if_sid>100700</if_sid>
    <field name="log" type="pcre2">"action":\s*"model_(created|updated|deleted)".*"model_name":\s*"[a-z0-9]*(flow|policy|binding|stage|provider|application|outpost|group|token|source|brand|tenant)"</field>
    <description>Authentik: flow, policy, provider or token configuration changed</description>
    <group>config_changed,policy_changed,</group>
  </rule>
  <rule id="100706" level="8">
    <if_sid>100700</if_sid>
    <field name="log" type="pcre2">"action":\s*"(user_write|password_set|impersonation_started)"</field>
    <description>Authentik: user changed, password set or impersonation started</description>
    <group>account_changed,</group>
  </rule>
</group>
